# Copy to .env.local and fill in real values. Never commit .env.local.
# All variables here are bundled into the browser build, so none of them
# may be a secret (no AWS keys, no Supabase secret/service key).

# Node API base URL (see apps/api)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase project settings (Project Settings > API) — the anon/public key
# only, never the secret/service key. It is safe to expose: Postgres RLS
# and the Node API's own RBAC are what actually authorize requests.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
