# Copy to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# The web app's own base URL (not a secret) — used to build the redirect
# link in user-invitation emails. Must also be added to the Supabase
# project's Auth > URL Configuration > Redirect URLs allowlist.
WEB_APP_URL=http://localhost:5173

# AWS S3 (server-side only — never sent to web/mobile)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
S3_PRESIGN_EXPIRY_SECONDS=300
